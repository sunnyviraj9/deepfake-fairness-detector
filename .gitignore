# ── Python runtime ────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# ── Virtual environments ───────────────────────────────────────────
.venv/
venv/
ENV/
env/

# ── PyTorch / training weights (large binaries) ───────────────────
checkpoints/
*.pt
*.pth

# ── ONNX: exclude root-level .onnx but keep models/fairshield_model.onnx ──
/*.onnx
models/*.onnx_data

# ── Python training/backend scripts (not needed for web deploy) ───
train.py
evaluate.py
inference.py
benchmark.py
check_app.py
app.py
data/
configs/
utils/
tests/
scripts/

# ── Raw image datasets (100k+ files, never commit) ────────────────
dataset/imdb_wiki/
dataset/StableDiffusion1.5_wiki_processed_process/
data/raw/
data/processed/
images/
sample_images/

# ── Results: keep audit artifacts, ignore raw logs ────────────────
results/*.log
results/*.txt
results/train_*.txt

# ── Test / CI caches ───────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/

# ── Build & packaging ──────────────────────────────────────────────
build/
dist/
*.egg-info/
.eggs/
wheels/

# ── IDE & OS ───────────────────────────────────────────────────────
.vscode/
.idea/
*.DS_Store
Thumbs.db
*.swp
*.swo

# ── Jupyter ────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── W&B / MLflow experiment tracking ──────────────────────────────
.wandb/
mlruns/
runs/
logs/
benchmark_results/
inference_results/
