# ── Python runtime ────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# ── Virtual environments ───────────────────────────────────────────
.venv/
venv/
ENV/
env/

# ── PyTorch model weights (large binaries — use Git LFS or DVC) ───
