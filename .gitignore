*.pt
*.pth
*.onnx

# ── Raw image datasets (100k+ files, never commit) ────────────────
dataset/imdb_wiki/
dataset/StableDiffusion1.5_wiki_processed_process/
data/raw/
data/processed/
images/
sample_images/

# ── Results: keep audit artifacts, ignore raw logs & run files ────
# (evaluation_summary.csv, fairness_audit_report.md,
#  fairness_disparity_plots.png, training_history.csv ARE tracked)
results/*.log
results/*.txt
results/train_*.txt

